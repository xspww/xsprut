DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-application-id"
# Optional: register slash commands to one or more guilds immediately.
# Use a comma-separated list if you want the bot to support multiple Discord servers.
DISCORD_GUILD_ID="your-guild-id"

# Optional: restrict slash commands to these comma-separated Discord user IDs.
ALLOWED_USER_IDS=""

# Enable this only if you have enabled the Guild Members intent in your bot settings
ENABLE_GUILD_MEMBERS_INTENT="false"

# dont change unless you know what your doing
CLIENTSETTINGS_BASE="https://clientsettings.roblox.com"

# ⏳ Anti-spam: default cooldown per user per command, in milliseconds.
# Set to 0 to disable the cooldown. (Individual commands may override this.)
COMMAND_COOLDOWN_MS="5000"
# How long the cooldown warning message stays before the bot auto-deletes it
# (0 = keep it forever).
COOLDOWN_MESSAGE_TTL_MS="5000"

# 🚨 Error notifications: a Discord webhook URL where the bot posts a message
# the moment an error/crash happens. Leave empty for log-only mode.
# Create one in your server: Server Settings > Integrations > Webhooks > New Webhook.
ERROR_WEBHOOK_URL=""

# 📝 File logging: append every log line to LOG_FILE (relative to the bot root).
# Set to false to disable.
LOG_TO_FILE="true"
LOG_FILE="bot.log"
